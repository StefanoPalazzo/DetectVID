# DetectVID Docker/VM environment
# Copy to .env and replace values for your deployment.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=detectvid

# Backend auth
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
NODE_ENV=production

# false for local HTTP only; use true for any HTTPS deployment.
COOKIE_SECURE=false

# Public URL used to build local image URLs. For local Docker use http://localhost.
# For a VM with HTTPS use https://your-domain.example
PUBLIC_BASE_URL=http://localhost

# CORS allowed origins. Keep the public URL and local dev URLs if needed.
FRONTEND_URLS=http://localhost,http://localhost:5173

# Storage provider: local is recommended for the VM MVP.
STORAGE_PROVIDER=local

# Optional Cloudinary credentials only if STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Deployment model: exp46 won internal validation; exp44 remains the existing deployment candidate after a limited field sanity-check.
# Supply the matching checkpoint externally in ml/checkpoints; it is not stored in Git.
MODEL_EXPERIMENT_ID=exp44_4cls_field_eff_quality_aug
